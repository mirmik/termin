<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Generated\TerminCsharpGeneratedProfile.props"
          Condition="Exists('Generated\TerminCsharpGeneratedProfile.props')" />
  <PropertyGroup Condition="'$(TerminCsharpProfile)' == ''">
    <TerminCsharpProfile>$(TerminCsharpGeneratedProfile)</TerminCsharpProfile>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Suppress CS8981 for SWIG-generated lowercase type 'termin' -->
    <NoWarn>CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TerminCsharpProfile)' == 'plot-d3d11'">
    <DefineConstants>$(DefineConstants);TERMIN_CSHARP_PLOT_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TerminCsharpProfile)' != 'plot-d3d11'">
    <Compile Remove="TerminCore.Plot.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TerminCsharpProfile)' == 'plot-d3d11'">
    <Compile Remove="D3D11OffscreenDisplay.cs" />
    <Compile Remove="ComponentRef.cs" />
    <Compile Remove="CSharpComponent.cs" />
    <Compile Remove="CSharpComponentRuntime.cs" />
    <Compile Remove="Entity.cs" />
    <Compile Remove="EntityPool.cs" />
    <Compile Remove="InspectFieldAttribute.cs" />
    <Compile Remove="Scene.cs" />
    <Compile Remove="SwigHelper.cs" />
    <Compile Remove="SwigHelpers.cs" />
    <Compile Remove="TcEntityId.cs" />
    <Compile Remove="TcValue.cs" />
    <Compile Remove="TerminCore.cs" />
    <Compile Remove="TerminOpenGL.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="share\**\*" Pack="true" PackagePath="share" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateTerminCsharpGeneratedProfile" BeforeTargets="CoreCompile">
    <Error Condition="'$(TerminCsharpGeneratedProfile)' == ''"
           Text="C# bindings have not been generated. Configure and build termin-csharp before building Termin.Native." />
    <Error Condition="'$(TerminCsharpProfile)' != '$(TerminCsharpGeneratedProfile)'"
           Text="Requested C# profile '$(TerminCsharpProfile)' does not match generated bindings profile '$(TerminCsharpGeneratedProfile)'. Reconfigure termin-csharp with -DTERMIN_CSHARP_PROFILE=$(TerminCsharpProfile) and build the native target first." />
  </Target>

</Project>
