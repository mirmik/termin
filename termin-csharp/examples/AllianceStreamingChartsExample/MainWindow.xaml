<Window x:Class="AllianceStreamingChartsExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:termin="clr-namespace:Termin.Wpf;assembly=Termin.Wpf"
        Title="Alliance-style retained streaming charts"
        Width="1180"
        Height="860"
        MinWidth="760"
        MinHeight="620"
        Background="#15171B">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#4C5362"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <termin:RetainedScene2DHost x:Name="SceneHost" />
            </Border>

            <ScrollBar x:Name="PanelScrollBar"
                       Grid.Column="1"
                       Width="16"
                       Margin="6,0,0,0"
                       Orientation="Vertical"
                       SmallChange="48"
                       LargeChange="220" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="2,8,2,0"
                   Foreground="#D9DCE3"
                   FontSize="13"
                   Text="Middle-drag pans; wheel zooms; Ctrl+wheel zooms shared X only." />
    </Grid>
</Window>
