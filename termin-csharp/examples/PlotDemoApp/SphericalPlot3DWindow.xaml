<Window x:Class="PlotDemoApp.SphericalPlot3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:termin="clr-namespace:Termin.Wpf;assembly=Termin.Wpf"
        Title="tcplot - spherical mesh demo"
        Width="1000" Height="760"
        MinWidth="720" MinHeight="520"
        Background="#15171B"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Spherical surface: radius by azimuth and polar angle"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Advance wave"
                        Padding="12,6" Margin="8,0,0,0"
                        Click="OnAdvanceWave"/>
                <Button x:Name="WireframeButton"
                        Content="Wireframe"
                        Padding="12,6" Margin="8,0,0,0"
                        Click="OnToggleWireframe"/>
                <Button Content="Fit camera"
                        Padding="12,6" Margin="8,0,0,0"
                        Click="OnFitCamera"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#4C5362"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
            <termin:RetainedChart3DHost x:Name="ChartHost"/>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="2,8,2,0"
                   Foreground="#D9DCE3"
                   FontSize="13"
                   Text="Left-drag: orbit; middle-drag: pan; mouse wheel: zoom."/>
    </Grid>
</Window>
