<Window x:Class="RetainedChart3DWpfExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:termin="clr-namespace:Termin.Wpf;assembly=Termin.Wpf"
        Title="Retained Chart3D from C#"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="520"
        Background="#15171B">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#4C5362"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
            <termin:RetainedChart3DHost x:Name="ChartHost" />
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="2,8,2,0"
                   Foreground="#D9DCE3"
                   FontSize="13"
                   Text="Drag to orbit; use the mouse wheel to zoom." />
    </Grid>
</Window>
