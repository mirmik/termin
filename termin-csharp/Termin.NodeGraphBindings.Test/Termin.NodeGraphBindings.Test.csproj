<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TerminSdkRoot)' == ''">
    <ProjectReference Include="..\Termin.Native\Termin.Native.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TerminSdkRoot)' != ''">
    <Reference Include="Termin.Native" HintPath="$(TerminSdkRoot)\csharp\lib\netstandard2.1\Termin.Native.dll" Private="true" />
    <None Include="$(TerminSdkRoot)\csharp\runtimes\win-x64\native\*"
          TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TerminSdkRoot)\csharp\share\**\*"
          Link="share\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\pws.json" Link="fixtures\pws.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateInstalledSdk" BeforeTargets="ResolveReferences" Condition="'$(TerminSdkRoot)' != ''">
    <Error Condition="!Exists('$(TerminSdkRoot)\csharp\lib\netstandard2.1\Termin.Native.dll')"
           Text="TerminSdkRoot must point to an installed SDK containing Termin.Native.dll." />
    <Error Condition="!Exists('$(TerminSdkRoot)\csharp\runtimes\win-x64\native\termin_nodegraph_core.dll')"
           Text="Installed Graphics SDK must contain the native nodegraph runtime." />
  </Target>
</Project>
