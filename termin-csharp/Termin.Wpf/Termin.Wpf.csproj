<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Termin.Native\Generated\TerminCsharpGeneratedProfile.props"
          Condition="Exists('..\Termin.Native\Generated\TerminCsharpGeneratedProfile.props')" />
  <PropertyGroup Condition="'$(TerminCsharpProfile)' == ''">
    <TerminCsharpProfile>$(TerminCsharpGeneratedProfile)</TerminCsharpProfile>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.1;net8.0-windows</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TerminCsharpProfile)' == 'plot-d3d11'">
    <DefineConstants>$(DefineConstants);TERMIN_CSHARP_PLOT_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termin.Native\Termin.Native.csproj" />
  </ItemGroup>
</Project>
