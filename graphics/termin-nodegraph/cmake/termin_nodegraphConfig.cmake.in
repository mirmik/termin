@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(termin_base CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/termin_nodegraphTargets.cmake")
set(termin_nodegraph_core_FOUND TRUE)

if("ui" IN_LIST termin_nodegraph_FIND_COMPONENTS)
    find_dependency(termin_visual_scene CONFIG REQUIRED)
    find_dependency(termin_gui_native CONFIG REQUIRED)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/termin_nodegraphUiTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/termin_nodegraphUiTargets.cmake")
        set(termin_nodegraph_ui_FOUND TRUE)
    else()
        set(termin_nodegraph_ui_FOUND FALSE)
        set(termin_nodegraph_NOT_FOUND_MESSAGE
            "termin_nodegraph was built without the ui component")
    endif()
endif()

check_required_components(termin_nodegraph)
