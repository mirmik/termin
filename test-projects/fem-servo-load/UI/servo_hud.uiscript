uiscript: 2
root:
  type: termin.gui.OverlayLayout
  name: physics_overlay
  safe_area: respect
  background_color: [0, 0, 0, 0]
  children:
    - type: termin.gui.Panel
      name: card_background
      anchor: top-right
      offset: [-18, 18]
      layout:
        width: 620
        height: 650
      background_color: [0.02, 0.04, 0.075, 0.94]
    - type: termin.gui.VStack
      name: telemetry_card
      anchor: top-right
      offset: [-18, 18]
      layout:
        width: 620
        height: 650
      padding: [18, 14, 18, 14]
      spacing: 5
      children:
        - type: termin.gui.Label
          name: card_title
          text: REDUCED ARTICULATION / SERVO LOAD
          font_size: 13
          color: [0.35, 0.74, 1.0, 1]
          basis: preferred
        - type: termin.gui.Label
          name: energy_value
          text: waiting for solver
          font_size: 27
          color: [0.94, 0.98, 1.0, 1]
          basis: preferred
        - type: termin.gui.Label
          name: energy_change
          text: mechanical energy change
          font_size: 12
          color: [0.58, 0.76, 0.90, 1]
          basis: preferred
        - type: termin.gui.Panel
          name: divider
          background_color: [0.18, 0.34, 0.48, 0.9]
          basis: 1
        - type: termin.gui.Label
          name: simulation_value
          text: 0.00 s   ·   0 steps
          font_size: 14
          color: [0.84, 0.91, 0.96, 1]
          basis: preferred
        - type: termin.gui.Label
          name: topology_value
          text: QP multibody   ·   waiting for topology
          font_size: 12
          color: [0.48, 0.67, 0.80, 1]
          basis: preferred
        - type: termin.gui.Label
          name: motor_value
          text: waiting for motor contribution
          font_size: 12
          color: [0.96, 0.68, 0.28, 1]
          basis: preferred
        - type: termin.gui.Label
          name: servo_value
          text: waiting for servo binding
          font_size: 12
          color: [0.48, 0.92, 0.70, 1]
          basis: preferred
        - type: termin.gui.Plot2D
          name: servo_plot
          title: SERVO COORDINATE
          x_label: time, s
          y_label: angle, deg
          auto_fit: true
          basis: 205
        - type: termin.gui.Label
          name: effort_legend
          text: "position: blue   integral: orange   velocity: green   command: purple   applied: red dashed"
          font_size: 11
          color: [0.72, 0.80, 0.86, 1]
          basis: preferred
        - type: termin.gui.Plot2D
          name: servo_effort_plot
          title: CONTROL EFFORT
          x_label: time, s
          y_label: effort, N*m
          auto_fit: true
          basis: 205
