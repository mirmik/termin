{
  "schema_version": 1,
  "description": "Language-neutral 2D and 3D multibody dynamics fixtures. Trajectories are judged by physical invariants and analytic states where available, not by solver iteration counts or bitwise integration parity.",
  "conventions": {
    "pose2": ["world_x", "world_y", "angle_radians"],
    "velocity2": ["world_vx", "world_vy", "angular_velocity"],
    "acceleration2": ["world_ax", "world_ay", "angular_acceleration"],
    "pose3": ["world_translation_xyz", "quaternion_xyzw"],
    "velocity3": ["world_linear_xyz", "world_angular_xyz"],
    "acceleration3": ["world_linear_xyz", "world_angular_xyz"],
    "spatial_vector3": ["world_linear_xyz", "world_angular_xyz"],
    "constraint": "J * acceleration = gamma",
    "gravity_frame": "world",
    "quaternion_equivalence": "q and -q represent the same 3D orientation"
  },
  "legacy_classification": [
    {
      "module": "termin.fem.multibody2d_3",
      "decision": "oracle",
      "note": "Reference for 2D rigid bodies, fixed-point joints, revolute joints and projection behavior."
    },
    {
      "module": "termin.fem.multibody3d_3.RigidBody3D",
      "decision": "reference-only",
      "note": "Useful spatial-inertia and frame fixtures; integration details are not a normative native contract."
    },
    {
      "module": "termin.fem.multibody3d_3.RevoluteJoint3D",
      "decision": "retire-name",
      "note": "The legacy class constrains only coincident points and is a point/ball joint, not an axis-constrained 3D revolute joint."
    },
    {
      "module": "termin.fem.doll2d",
      "decision": "reference-only",
      "note": "Articulated-coordinate experiment; not part of the first maximal-coordinate native vertical slice."
    }
  ],
