{
  "schema": 1,
  "description": "Documentation publication inventory joined to repository module identities. Every repository-owned docs root is public or explicitly internal.",
  "inventory": {
    "exclude_roots": [
      "build",
      "sdk",
      "termin-thirdparty"
    ],
    "exclude_directory_names": [
      ".git",
      ".venv",
      "__pycache__",
      "node_modules"
    ]
  },
  "public_sites": [
    {
      "module": null,
      "root": "docs",
      "config": "mkdocs.yml",
      "site_path": "."
    },
    {
      "module": "termin-app",
      "root": "editor/termin-app/docs",
      "config": "editor/termin-app/mkdocs.yml",
      "site_path": "termin-app"
    },
    {
      "module": "termin-collision",
      "root": "physics/termin-collision/docs",
      "config": "physics/termin-collision/mkdocs.yml",
      "site_path": "termin-collision"
    },
    {
      "module": "termin-scene",
      "root": "engine/termin-scene/docs",
      "config": "engine/termin-scene/mkdocs.yml",
      "site_path": "termin-scene"
    },
    {
      "module": "termin-modules",
      "root": "engine/termin-modules/docs",
      "config": "engine/termin-modules/mkdocs.yml",
      "site_path": "termin-modules"
    }
  ],
  "internal_roots": [
    "core/termin-base/docs",
    "core/termin-build-tools/docs",
    "core/termin-dispatch/docs",
    "core/termin-inspect/docs",
    "core/termin-nanobind-sdk/docs",
    "editor/termin-glb-adapters/docs",
    "engine/termin-audio/docs",
    "engine/termin-components/docs",
    "engine/termin-components/termin-components-animation/docs",
    "engine/termin-components/termin-components-collision/docs",
    "engine/termin-components/termin-components-kinematic/docs",
    "engine/termin-components/termin-components-mesh/docs",
    "engine/termin-components/termin-components-physics/docs",
    "engine/termin-components/termin-components-render/docs",
    "engine/termin-components/termin-components-skeleton/docs",
    "engine/termin-components/termin-components-tween/docs",
    "engine/termin-components/termin-components-ui/docs",
    "engine/termin-components/termin-components-voxels/docs",
    "engine/termin-default-assets/docs",
    "engine/termin-display/docs",
    "engine/termin-engine/docs",
    "engine/termin-framegraph-remote-client/docs",
    "engine/termin-framegraph-remote-target/docs",
    "engine/termin-framegraph-remote/docs",
    "engine/termin-input/docs",
    "engine/termin-lighting/docs",
    "engine/termin-prefab/docs",
    "engine/termin-profiler-remote/docs",
    "engine/termin-render-passes/docs",
    "engine/termin-render/docs",
    "engine/termin-stdlib/docs",
    "engine/termin-voxels/docs",
    "graphics/tcplot/docs",
    "graphics/termin-animation/docs",
    "graphics/termin-glb/docs",
    "graphics/termin-graphics/docs",
    "graphics/termin-gui-native/docs",
    "graphics/termin-mesh/docs",
    "graphics/termin-nodegraph/docs",
    "graphics/termin-render-core/docs",
    "graphics/termin-skeleton/docs",
    "graphics/termin-tween/docs",
    "graphics/termin-visual-scene/docs",
    "graphics/termin-window/docs",
    "physics/termin-navmesh/docs",
    "physics/termin-physics-fem/docs",
    "physics/termin-physics/docs",
    "termin-csharp/docs",
    "test-projects/android-render-showcase/docs"
  ]
}
