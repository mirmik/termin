#!/usr/bin/env python3
"""Exercise the supported Xvfb/Mesa editor path and its MCP lifecycle."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time
import zlib
from pathlib import Path


class SmokeError(RuntimeError):
    pass


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _write_project(project_root: Path) -> Path:
    project_root.mkdir(parents=True)
    project_file = project_root / "VirtualDisplaySmoke.terminproj"
    project_file.write_text(
        json.dumps({"version": 1, "name": "VirtualDisplaySmoke"}, indent=2),
        encoding="utf-8",
    )
    (project_root / "Main.scene").write_text(
        json.dumps({"scene": {"entities": []}}, indent=2),
        encoding="utf-8",
    )
    settings = project_root / "project_settings"
    settings.mkdir()
    (settings / "project.json").write_text(
        json.dumps(
            {
                "render_sync_mode": "none",
                "build_output_dir": "dist",
                "ignored_resource_paths": [],
            },
            indent=2,
        ),
        encoding="utf-8",
    )
    (settings / ".editor_state.json").write_text(
        json.dumps({"last_scene": str(project_root / "Main.scene")}, indent=2),
        encoding="utf-8",
    )
    return project_file


def _run_helper(
    sdk_python: Path,
    helper: Path,
    session_file: Path,
    command: list[str],
    *,
    timeout: float = 15.0,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [str(sdk_python), str(helper), "--session", str(session_file), *command],
        cwd=_repo_root(),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=timeout,
        check=False,
    )


def _wait_for_mcp(
    process: subprocess.Popen[str],
    sdk_python: Path,
    helper: Path,
    session_file: Path,
    timeout: float,
) -> None:
    deadline = time.monotonic() + timeout
    last_output = ""
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise SmokeError(f"Virtual-display editor exited before MCP became ready, code={process.returncode}")
        result = _run_helper(sdk_python, helper, session_file, ["tools-list"])
        last_output = result.stdout
        if result.returncode == 0:
            return
        time.sleep(0.25)
    raise SmokeError(f"Timed out waiting for editor MCP.\n{last_output}")


def _require_success(result: subprocess.CompletedProcess[str], description: str) -> str:
    if result.returncode != 0:
        raise SmokeError(f"{description} failed with code {result.returncode}:\n{result.stdout}")
    return result.stdout


def _png_has_visible_pixel(path: Path) -> bool:
    data = path.read_bytes()
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        raise SmokeError(f"Frame capture is not a PNG file: {path}")

    offset = 8
    width = height = bit_depth = color_type = interlace = 0
    compressed = bytearray()
    while offset + 12 <= len(data):
        length = struct.unpack_from(">I", data, offset)[0]
        chunk_type = data[offset + 4 : offset + 8]
        payload_start = offset + 8
        payload_end = payload_start + length
        if payload_end + 4 > len(data):
            raise SmokeError(f"Frame capture contains a truncated PNG chunk: {path}")
        payload = data[payload_start:payload_end]
        if chunk_type == b"IHDR":
            width, height, bit_depth, color_type, _, _, interlace = struct.unpack(">IIBBBBB", payload)
        elif chunk_type == b"IDAT":
            compressed.extend(payload)
        elif chunk_type == b"IEND":
            break
        offset = payload_end + 4

    channels = {0: 1, 2: 3, 4: 2, 6: 4}.get(color_type)
    if not width or not height or bit_depth != 8 or channels is None or interlace != 0:
        raise SmokeError(
            "Frame capture uses an unsupported PNG layout "
            f"({width}x{height}, depth={bit_depth}, color={color_type}, interlace={interlace})"
        )

    row_bytes = width * channels
    decoded = zlib.decompress(compressed)
    if len(decoded) != height * (row_bytes + 1):
        raise SmokeError(f"Frame capture has an invalid decoded size: {path}")

    previous = bytearray(row_bytes)
    cursor = 0
    for _ in range(height):
        filter_type = decoded[cursor]
        cursor += 1
        row = bytearray(decoded[cursor : cursor + row_bytes])
        cursor += row_bytes
        for index in range(row_bytes):
            left = row[index - channels] if index >= channels else 0
            above = previous[index]
            upper_left = previous[index - channels] if index >= channels else 0
            if filter_type == 1:
                row[index] = (row[index] + left) & 0xFF
            elif filter_type == 2:
                row[index] = (row[index] + above) & 0xFF
            elif filter_type == 3:
                row[index] = (row[index] + ((left + above) // 2)) & 0xFF
            elif filter_type == 4:
                predictor = left + above - upper_left
                distances = (
                    abs(predictor - left),
                    abs(predictor - above),
                    abs(predictor - upper_left),
                )
                row[index] = (row[index] + (left, above, upper_left)[distances.index(min(distances))]) & 0xFF
            elif filter_type != 0:
                raise SmokeError(f"Frame capture uses unknown PNG filter {filter_type}")
        color_channels = 1 if color_type in (0, 4) else 3
        if any(
            row[index] for pixel in range(width) for index in range(pixel * channels, pixel * channels + color_channels)
        ):
            return True
        previous = row
    return False


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--timeout", type=float, default=60.0)
    parser.add_argument("--keep-temp", action="store_true")
    args = parser.parse_args()

    root = _repo_root()
    wrapper = root / "scripts" / "termin-editor-virtual-display"
    helper = root / "scripts" / "termin-editor-mcp"
    editor = root / "sdk" / "bin" / "termin_editor"
    sdk_python = root / "sdk" / "bin" / "termin_python"
    for path, label in (
        (wrapper, "virtual-display wrapper"),
        (helper, "editor MCP helper"),
        (editor, "SDK editor"),
        (sdk_python, "SDK Python"),
    ):
        if not path.is_file():
            raise SmokeError(f"{label} not found: {path}")

    temp_dir = Path(tempfile.mkdtemp(prefix="termin-editor-virtual-display-smoke-"))
    project_file = _write_project(temp_dir / "project")
    session_file = temp_dir / "session.json"
    log_path = temp_dir / "editor.log"
    environment = os.environ.copy()
    environment["HOME"] = str(temp_dir / "home")

    process: subprocess.Popen[str] | None = None
    try:
        command = [
            str(wrapper),
            "--editor",
            str(editor),
            "--session-file",
            str(session_file),
            str(project_file),
        ]
        print("[virtual-display-smoke] command:", " ".join(command), flush=True)
        print("[virtual-display-smoke] log:", log_path, flush=True)
        with log_path.open("w", encoding="utf-8") as log_file:
            process = subprocess.Popen(
                command,
                cwd=root,
                env=environment,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                text=True,
                start_new_session=True,
            )
            _wait_for_mcp(process, sdk_python, helper, session_file, args.timeout)
            _require_success(
                _run_helper(sdk_python, helper, session_file, ["initialize"]),
                "MCP initialize",
            )
            tools_output = _require_success(
                _run_helper(sdk_python, helper, session_file, ["tools-list"]),
                "MCP tools/list",
            )
            if "execute_python_script" not in tools_output:
                raise SmokeError(f"MCP tools/list did not advertise execute_python_script:\n{tools_output}")
            probe_output = _require_success(
                _run_helper(
                    sdk_python,
                    helper,
                    session_file,
                    [
                        "exec",
                        (
                            "import json; print(json.dumps({"
                            "'project_path': project_path, "
                            "'has_scene': scene is not None}))"
                        ),
                    ],
                ),
                "MCP editor probe",
            )
            if str(project_file.parent) not in probe_output or '"has_scene": true' not in probe_output:
                raise SmokeError(f"MCP editor probe did not confirm the project and scene:\n{probe_output}")
            framegraph_output = _require_success(
                _run_helper(
                    sdk_python,
                    helper,
                    session_file,
                    ["framegraph"],
                    timeout=30.0,
                ),
                "MCP framegraph inspection",
            )
            framegraph = json.loads(framegraph_output)
            editor_targets = [
                target
                for target in framegraph.get("targets", [])
                if target.get("label") == "Editor / (Editor) / (Editor)"
            ]
            if len(editor_targets) != 1:
                raise SmokeError(f"Framegraph inspection did not find exactly one editor target:\n{framegraph_output}")
            editor_target_index = str(editor_targets[0]["index"])
            frame_path = temp_dir / "editor-frame.png"
            _require_success(
                _run_helper(
                    sdk_python,
                    helper,
                    session_file,
                    [
                        "framegraph-capture",
                        "--target-index",
                        editor_target_index,
                        "--resource",
                        "color+widgets",
                        "--path",
                        str(frame_path),
                    ],
                    timeout=30.0,
                ),
                "MCP editor frame capture",
            )
            if not _png_has_visible_pixel(frame_path):
                raise SmokeError(f"Editor frame capture is completely black: {frame_path}")
            _require_success(
                _run_helper(
                    sdk_python,
                    helper,
                    session_file,
                    ["exec", "request_editor_close(); print('close requested')"],
                ),
                "MCP clean shutdown request",
            )
            try:
                return_code = process.wait(timeout=20.0)
            except subprocess.TimeoutExpired as exc:
                raise SmokeError("Editor did not exit after request_editor_close()") from exc
            if return_code != 0:
                raise SmokeError(f"Virtual-display editor exited with code {return_code}")

        log_text = log_path.read_text(encoding="utf-8", errors="replace")
        required_markers = (
            "[virtual-display] Mesa preflight:",
            "llvmpipe",
            "GLSL=4.60",
            "[EngineCore] Shutdown complete",
        )
        missing = [marker for marker in required_markers if marker not in log_text]
        if missing:
            raise SmokeError(f"Editor log is missing clean virtual-display evidence: {missing}\n{log_text}")
        forbidden_markers = (
            "unsupported target: opengl450",
            "termin_shaderc failed",
            "failed to create shader",
            "output transform failed",
        )
        present = [marker for marker in forbidden_markers if marker in log_text]
        if present:
            raise SmokeError(f"Editor log contains shader failures: {present}\n{log_text}")
        print("[virtual-display-smoke] PASS", flush=True)
        return 0
    except Exception:
        if log_path.is_file():
            print(
                f"[virtual-display-smoke] log tail ({log_path}):",
                file=sys.stderr,
            )
            for line in log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-100:]:
                print(line, file=sys.stderr)
        raise
    finally:
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=8.0)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5.0)
        if args.keep_temp:
            print("[virtual-display-smoke] kept temp:", temp_dir, flush=True)
        else:
            shutil.rmtree(temp_dir, ignore_errors=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SmokeError as exc:
        print(f"[virtual-display-smoke] FAIL: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
