@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(termin_base REQUIRED)
find_dependency(termin_graphics REQUIRED)
find_dependency(termin_scene REQUIRED)
find_dependency(termin_input REQUIRED)
find_dependency(termin_render REQUIRED)

set(termin_display_HAS_SDL @TERMIN_DISPLAY_HAS_SDL@)
set(termin_display_REQUIRES_SDL2_PACKAGE @TERMIN_DISPLAY_REQUIRES_SDL2_PACKAGE@)

include("${CMAKE_CURRENT_LIST_DIR}/termin_displayTargets.cmake")

foreach(_termin_display_component IN LISTS termin_display_FIND_COMPONENTS)
    if(NOT _termin_display_component STREQUAL "window")
        set(termin_display_FOUND FALSE)
        set(termin_display_NOT_FOUND_MESSAGE
            "Unsupported termin_display component: ${_termin_display_component}")
        return()
    endif()
endforeach()

if("window" IN_LIST termin_display_FIND_COMPONENTS)
    if(NOT termin_display_HAS_SDL)
        set(termin_display_FOUND FALSE)
        set(termin_display_NOT_FOUND_MESSAGE
            "termin_display window component was built without SDL")
        return()
    endif()
    find_dependency(termin_window REQUIRED)
    if(termin_display_REQUIRES_SDL2_PACKAGE AND NOT TARGET SDL2::SDL2)
        find_dependency(SDL2 REQUIRED)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/termin_displayWindowTargets.cmake")
endif()

check_required_components(termin_display)
